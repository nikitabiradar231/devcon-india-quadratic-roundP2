# ==============================================================================
# CONFIGURATION TEMPLATE 2: TESTNET-ONLY DEMO (OPERATOR STAGING RECIPIENT)
# ==============================================================================
# Use this configuration ONLY when distinct project maintainer addresses are not yet
# available and you wish to demonstrate the end-to-end claiming mechanics using the
# operator wallet as the designated staging recipient for all 4 draft projects.
#
# IMPORTANT:
# - This mode is STRICTLY for testnet evaluation.
# - It does NOT represent four independent development teams.
# - UI will display a "[TESTNET DEMO ONLY]" disclaimer.
# - Requires explicit opt-in via ALLOW_DEMO_RECIPIENTS=true.
# ==============================================================================

# Network RPC
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer / Operator Credentials (Private key only in local .env, NEVER in git)
DEPLOYER_PRIVATE_KEY=
OPERATOR_ADDRESS=

# Round Timing (Leave blank for dynamic 2-hour buffer and 7-day duration, or specify Unix timestamps)
ROUND_START=
ROUND_END=

# Sybil-Resistant Contributor Eligibility Root (200-member tree)
ELIGIBILITY_ROOT=0x3d46a36f54db9dafd55ba03b00ccea72265b806e0cf494752ec20e9c20ab680d

# Initial Matching Pool (Default: 0 ETH until approved)
INITIAL_MATCHING_POOL=0

# RECIPIENT MODE: Explicit Testnet-Only Demo Mode
ALLOW_DEMO_RECIPIENTS=true

# When ALLOW_DEMO_RECIPIENTS=true, individual project recipient variables
# default to OPERATOR_ADDRESS if left empty:
PROJECT_1_RECIPIENT=
PROJECT_2_RECIPIENT=
PROJECT_3_RECIPIENT=
PROJECT_4_RECIPIENT=

# Frontend Configuration (Sepolia Chain ID: 11155111)
VITE_CHAIN_ID=11155111
VITE_CONTRACT_ADDRESS=
