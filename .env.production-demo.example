# ==============================================================================
# CONFIGURATION TEMPLATE 1: PRODUCTION-LIKE LIVE DEMO (DISTINCT RECIPIENTS)
# ==============================================================================
# Use this configuration when 4 distinct project maintainer wallets or multisigs
# are available. Claims will disburse directly to each project's respective address.
#
# IMPORTANT:
# - Do NOT commit your actual .env file or private keys.
# - Supply 4 separate, verified Sepolia recipient addresses below.
# ==============================================================================

# Network RPC
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer / Operator Credentials (Private key only in local .env, NEVER in git)
DEPLOYER_PRIVATE_KEY=
OPERATOR_ADDRESS=

# Round Timing (Leave blank for dynamic 2-hour buffer and 7-day duration, or specify Unix timestamps)
ROUND_START=
ROUND_END=

# Sybil-Resistant Contributor Eligibility Root (200-member tree)
ELIGIBILITY_ROOT=0x3d46a36f54db9dafd55ba03b00ccea72265b806e0cf494752ec20e9c20ab680d

# Initial Matching Pool (Default: 0 ETH until approved)
INITIAL_MATCHING_POOL=0

# RECIPIENT MODE: Distinct Production Recipients (Strictly enforced)
ALLOW_DEMO_RECIPIENTS=false

# Project 1: Community Education & Dev Tools
PROJECT_1_RECIPIENT=

# Project 2: Whale Funded Tooling
PROJECT_2_RECIPIENT=

# Project 3: ZK Privacy Tools
PROJECT_3_RECIPIENT=

# Project 4: Decentralized RPC Gateway
PROJECT_4_RECIPIENT=

# Frontend Configuration (Sepolia Chain ID: 11155111)
VITE_CHAIN_ID=11155111
VITE_CONTRACT_ADDRESS=
